{
  "name": "harness-comet-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "harness-comet": "node packages/cli/bin/harness-comet.js",
    "setup:browsers": "pnpm --filter @harness-comet/adapter-playwright exec playwright install chromium",
    "pack:dry-run": "pnpm -r --filter './packages/*' exec npm pack --dry-run",
    "release:check": "pnpm build && pnpm test && pnpm pack:dry-run"
  },
  "devDependencies": {
    "@harness-comet/adapter-memory": "workspace:*",
    "@harness-comet/adapter-playwright": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "execa": "^9.6.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
