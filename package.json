{
  "name": "harness-comet-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "harness-comet": "node packages/cli/bin/harness-comet.js",
    "sync:comet-skills": "node scripts/sync-comet-managed-skills.mjs",
    "setup:browsers": "pnpm --filter @hapergg/harness-comet-adapter-playwright exec playwright install chromium",
    "release:check": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm lint",
    "pack:all": "node scripts/pack-all.mjs",
    "pack:dry-run": "pnpm pack:all",
    "test:consumer": "node scripts/test-packed-consumer.mjs",
    "changeset": "changeset && changeset version",
    "version-packages": "changeset version",
    "publish": "pnpm changeset publish",
    "release": "pnpm release:check && pnpm pack:all && pnpm test:consumer && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.1",
    "@hapergg/harness-comet-adapter-memory": "workspace:*",
    "@hapergg/harness-comet-adapter-playwright": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "execa": "^9.6.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
