{
  "name": "@hapergg/harness-comet-core",
  "version": "0.4.0",
  "description": "Core discovery, validation, package-manager, and runtime utilities for Harness Comet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarperGG/harness-comet.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/HarperGG/harness-comet#readme",
  "bugs": {
    "url": "https://github.com/HarperGG/harness-comet/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "test": "vitest run",
    "prepack": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "dependencies": {
    "@hapergg/harness-comet-schema": "workspace:*",
    "@hapergg/harness-comet-sdk": "workspace:*",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
