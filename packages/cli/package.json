{
  "name": "@hapergg/harness-comet-cli",
  "version": "0.1.1",
  "description": "Command line interface for initializing, validating, and running Harness Comet projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarperGG/harness-comet.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/HarperGG/harness-comet#readme",
  "bugs": {
    "url": "https://github.com/HarperGG/harness-comet/issues"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc -b && chmod +x bin/harness-comet.js",
    "test": "vitest run",
    "prepack": "test -f dist/index.js && test -f dist/index.d.ts && test -x bin/harness-comet.js"
  },
  "bin": {
    "harness-comet": "./bin/harness-comet.js"
  },
  "dependencies": {
    "@hapergg/harness-comet-adapter-memory": "workspace:*",
    "@hapergg/harness-comet-adapter-playwright": "workspace:*",
    "@hapergg/harness-comet-comet-adapter": "workspace:*",
    "@hapergg/harness-comet-core": "workspace:*",
    "@hapergg/harness-comet-schema": "workspace:*",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
